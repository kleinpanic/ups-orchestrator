# Install to ~/.config/systemd/user/ups-orchestrator-tick.service  (systemd --user; no sudo)
# One-shot: checks every UPS and posts an on-battery runtime countdown.
# Runs as your user; reads the shared env file (you must be in the `nut` group
# to read /etc/ups-orchestrator.env). Linger keeps it running while logged out.
[Unit]
Description=ups-orchestrator on-battery tick (Discord runtime countdown)

[Service]
Type=oneshot
EnvironmentFile=/etc/ups-orchestrator.env
ExecStart=/usr/local/bin/ups-orchestrator tick
