# Install to ~/.config/systemd/user/ups-orchestrator-watch.service  (systemd --user; no sudo)
#
# Long-running poll loop: every `poll_seconds` (from config.json) it checks each
# UPS, evaluates the opt-in shutdown policy, and posts the on-battery countdown.
# Runs as your user; reads the shared env file (you must be in the `nut` group,
# or have the ACL set by deploy/install.sh, to read /etc/ups-orchestrator.env).
# Enable linger so it runs while logged out.
[Unit]
# The shutdown gate measures `min_on_battery_seconds` from a wall-clock stamp, and this
# host has no RTC — it restores an approximate time at boot and timesyncd steps it later.
# Starting before that step meant a stamp recorded against the pre-step clock, so the
# correction alone could satisfy the 180s gate and turn a 10-second sag into a shutdown.
# Restart=always makes this reachable on any crash-restart during an outage, not just at
# boot. Ordering after the sync closes the boot case at the source.
After=time-sync.target
Wants=time-sync.target
# Page Discord if this unit dies. The orchestrator cannot report its own death.
OnFailure=ups-orchestrator-alert@%n.service
# These two live in [Unit], NOT [Service] — systemd silently ignores them in [Service]
# and keeps its 10s default, which `systemctl show -p StartLimitIntervalUSec` reveals.
#
# Without a start limit that can actually TRIP, `Restart=always` means this unit never
# reaches `failed`: it loops in `activating` forever and OnFailure= never fires. The
# default 10s window is unreachable by construction at RestartSec=5, because five
# restarts take 25s. A 5-minute window makes a genuine crash-loop terminal, which is
# what turns it into a page instead of indefinite silence.
StartLimitIntervalSec=300
StartLimitBurst=5
Description=ups-orchestrator poll loop (policy-gated shutdowns + countdown)

[Service]
EnvironmentFile=/etc/ups-orchestrator.env
ExecStart=/usr/local/bin/ups-orchestrator watch
# Type=notify + WatchdogSec: systemd could previously see this process EXIT but never
# see it WEDGE. Restart=always covers a crash; nothing covered a poll loop stuck in a
# blocking read on a serial line or a hung subprocess — and a wedged loop stops polling
# every UPS, so during an outage it fires nothing and reports nothing while the unit
# still shows "active (running)".
#
# The ping is sent after each COMPLETED sweep of every UPS, so the watchdog measures the
# property that matters rather than mere process liveness. 120s is four times the default
# poll interval, which tolerates a slow poll on a loaded Pi without tolerating a wedge.
Type=notify
NotifyAccess=main
WatchdogSec=120
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
