# Install to ~/.config/systemd/user/ups-orchestrator-watch.service  (systemd --user; no sudo)
#
# Long-running poll loop: every `poll_seconds` (from config.json) it checks each
# UPS, evaluates the opt-in shutdown policy, and posts the on-battery countdown.
# Runs as your user; reads the shared env file (you must be in the `nut` group,
# or have the ACL set by deploy/install.sh, to read /etc/ups-orchestrator.env).
# Enable linger so it runs while logged out.
[Unit]
# The shutdown gate measures `min_on_battery_seconds` from a wall-clock stamp, and this
# host has no RTC — it restores an approximate time at boot and timesyncd steps it later.
# Starting before that step meant a stamp recorded against the pre-step clock, so the
# correction alone could satisfy the 180s gate and turn a 10-second sag into a shutdown.
# Restart=always makes this reachable on any crash-restart during an outage, not just at
# boot. Ordering after the sync closes the boot case at the source.
After=time-sync.target
Wants=time-sync.target
Description=ups-orchestrator poll loop (policy-gated shutdowns + countdown)

[Service]
Type=simple
EnvironmentFile=/etc/ups-orchestrator.env
ExecStart=/usr/local/bin/ups-orchestrator watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
