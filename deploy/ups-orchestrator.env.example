# Install to /etc/ups-orchestrator.env  (chmod 640, chown root:nut)
# Holds the secret + paths shared by the NUT (upssched) and systemd (tick) paths.
# NEVER commit the real file — only this .example is tracked.

# Discord incoming webhook URL (env var name must match config.json discord_webhook_env)
UPS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY

# Where the orchestrator reads config and writes per-UPS state.
UPS_ORCH_CONFIG=/etc/ups-orchestrator/config.json
UPS_ORCH_STATE=/var/lib/ups-orchestrator/state.json
UPS_ORCH_SAMPLES=/var/lib/ups-orchestrator/samples.jsonl
UPS_ORCH_EVENT_LOG=/var/lib/ups-orchestrator/events.jsonl
UPS_ORCH_NOTIFICATION_LOG=/var/lib/ups-orchestrator/notifications.jsonl

# Password the NUT secondaries (mt/spark) authenticate to the primary's upsd
# with. Set the real value here on the deployed box; leave empty in the repo.
# It MUST match the [upsmon_secondary] password in /etc/nut/upsd.users on
# eulerpi5 (see deploy/nut/upsd.users.snippet). Never commit a real value (SC6).
UPS_NUT_SECONDARY_PASSWORD=
