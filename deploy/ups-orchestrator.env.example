# Install to /etc/ups-orchestrator.env  (chmod 640, chown root:nut)
# Holds the secret + paths shared by the NUT (upssched) and systemd (tick) paths.
# NEVER commit the real file — only this .example is tracked.

# Discord incoming webhook URL (env var name must match config.json discord_webhook_env)
UPS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY

# Where the orchestrator reads config and writes per-UPS state.
UPS_ORCH_CONFIG=/etc/ups-orchestrator/config.json
UPS_ORCH_STATE=/var/lib/ups-orchestrator/state.json
