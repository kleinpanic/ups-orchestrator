# Append to /etc/nut/ups.conf — both CyberPower UPSes on local USB.
# The two devices are distinguished by USB productid (0601 vs 0501).

[cyberpower]
  driver = usbhid-ups
  port = auto
  vendorid = 0764
  productid = 0601
  serial = CYBMY7000053
  desc = "Rack UPS — CyberPower PR1500LCDRT2U"

[cyberpower2]
  driver = usbhid-ups
  port = auto
  vendorid = 0764
  productid = 0501
  desc = "Desk UPS — CyberPower CP1500 AVR"
