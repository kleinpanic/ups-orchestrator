# Append to /etc/nut/ups.conf — one [section] per UPS on local USB.
#
# Find each UPS's USB vendor/product id with `lsusb` (e.g. "ID 1234:abcd").
# Multiple same-brand units are distinguished by productid; add `serial = ...`
# only if two units share the same product id. Pick any [section] name you like
# (it becomes the NUT device name used in config.json + upsmon.conf).

[ups1]
  driver = usbhid-ups
  port = auto
  vendorid = VVVV
  productid = PPPP
  desc = "Rack UPS"

[ups2]
  driver = usbhid-ups
  port = auto
  vendorid = VVVV
  productid = PPPP
  desc = "Desk UPS"
