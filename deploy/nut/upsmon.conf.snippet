# Merge into /etc/nut/upsmon.conf — one MONITOR line per UPS.
#
# Use the same device names as ups.conf, and the upsmon password from
# /etc/nut/upsd.users. `primary` means this host runs the shutdown sequence.
# Set powervalue to 1 only for UPSes that actually feed this host; use 0 for
# notification-only UPSes so they don't confuse MINSUPPLIES decisions.
# NEVER commit real credentials.

MONITOR ups1@localhost 1 upsmon CHANGE_ME primary
MONITOR ups2@localhost 1 upsmon CHANGE_ME primary
MONITOR ups3@localhost 0 upsmon CHANGE_ME primary

# Route notifications through upssched (which calls the orchestrator).
NOTIFYCMD /sbin/upssched

# EXEC = run NOTIFYCMD; keep SYSLOG for journald visibility.
NOTIFYFLAG ONLINE   SYSLOG+EXEC
NOTIFYFLAG ONBATT   SYSLOG+EXEC
NOTIFYFLAG LOWBATT  SYSLOG+EXEC
NOTIFYFLAG COMMBAD  SYSLOG+EXEC
NOTIFYFLAG COMMOK   SYSLOG+EXEC

# NUT performs the real shutdown of THIS host when battery is critical.
SHUTDOWNCMD "/sbin/shutdown -h now"
