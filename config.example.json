{
  "discord_webhook_env": "UPS_DISCORD_WEBHOOK",
  "discord_webhook_url": "",
  "discord_username": "UPS Orchestrator",
  "discord_avatar_url": "",
  "poll_on_battery_seconds": 60,
  "upses": {
    "ups1": {
      "label": "Rack UPS",
      "shutdown_pi_on_lowbatt": false,
      "min_runtime_seconds_shutdown_pi": 300,
      "shutdown_targets": [
        {
          "name": "fileserver",
          "enabled": false,
          "host": "fileserver.lan",
          "user": "youruser",
          "cmd": "sudo /sbin/shutdown -h now",
          "delay_seconds": 300
        }
      ]
    },
    "ups2": {
      "label": "Desk UPS",
      "shutdown_pi_on_lowbatt": false,
      "min_runtime_seconds_shutdown_pi": 300,
      "shutdown_targets": []
    }
  }
}
