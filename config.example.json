{
  "discord_webhook_env": "UPS_DISCORD_WEBHOOK",
  "discord_webhook_url": "",
  "discord_username": "UPS Orchestrator",
  "discord_avatar_url": "",
  "poll_seconds": 30,
  "countdown_every_seconds": 60,
  "nut_server": {
    "listen": ["127.0.0.1", "::1"],
    "port": 3493,
    "secondary_user": "upsmon_secondary"
  },
  "monitored_machines__comment": "NUT secondaries enrolled via `monitor add`. Ships EMPTY: install.sh copies this file into production, so a worked example here would push a half-formed entry into the nft set. See docs/Configuration.md for the field shape and a worked mt/spark example.",
  "monitored_machines": [],
  "load_step": {
    "enabled": true,
    "drop_percent": 15,
    "cooldown_seconds": 600,
    "window_polls": 4
  },
  "shutdown": {
    "enabled": false,
    "require_power_outage": true,
    "min_on_battery_seconds": 120,
    "notify": true,
    "external": {
      "enabled": false,
      "battery_below": 15,
      "runtime_below": 300
    },
    "internal": {
      "enabled": false,
      "battery_below": 10,
      "runtime_below": 120
    }
  },
  "upses": {
    "ups1": {
      "label": "Rack UPS",
      "shutdown_targets__comment": "Default-off SSH/serial BACKUP path, below native NUT secondary shutdown. See docs/Shutdown-Targets.md — for a machine with a native secondary this MUST sit below its UPS's LB point (a deadman); for a machine with no secondary it stays the graceful path.",
      "shutdown_targets": [
        {
          "name": "fileserver",
          "kind": "remote",
          "enabled": false,
          "host": "fileserver.lan",
          "user": "youruser",
          "cmd": "sudo /sbin/shutdown -h now"
        },
        {
          "name": "bigserver-serial",
          "kind": "serial",
          "enabled": false,
          "device": "/dev/ttyUSB0",
          "baud": 115200,
          "cmd": "sudo /sbin/shutdown -h now"
        },
        {
          "name": "this-host",
          "kind": "local",
          "enabled": false,
          "cmd": "sudo /sbin/shutdown -h now"
        }
      ],
      "load_step": {
        "drop_percent": 30
      }
    },
    "ups2": {
      "label": "Desk UPS",
      "shutdown_targets": []
    },
    "ups3": {
      "label": "Third UPS",
      "shutdown_targets": []
    }
  }
}
