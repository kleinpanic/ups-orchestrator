# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Runtime state and local secrets — never commit these.
# The live config holds environment/host specifics; only config.example.json is tracked.
state.json
config.json
config.local.json
*.local.json
*.env
!*.env.example
.env

# Generated artifacts (dashboards/reports/telemetry) — never commit
*.png
*.jpg
*.jpeg
*.svg
samples.jsonl
samples.jsonl.*
events.jsonl
notifications.jsonl

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# mutmut working copy
mutants/
.mutmut-cache

# tools/mutation_test.py mutual-exclusion lock. Normally removed on exit; a
# SIGKILL or power loss can strand one, and a stranded lock is a thing to
# delete, never to commit.
.mutation-test.lock

# opencode CLI runtime state (from cross-AI reviews)
.opencode/

# Agent harness scratch: `.claude/worktrees/` holds throwaway git worktrees whose
# working copies are mid-edit by definition. Untracked but not ignored, they were
# being walked by `ruff check .` (make lint), so an unrelated agent's half-written
# file failed the repo's own lint gate.
.claude/

# mkdocs build output (make docs / mkdocs build)
site/
